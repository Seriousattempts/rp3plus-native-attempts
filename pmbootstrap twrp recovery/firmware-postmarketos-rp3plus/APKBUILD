# Maintainer: Your Name <your.email@example.com>
pkgname=firmware-postmarketos-rp3plus
pkgver=1.0
pkgrel=1  # Increment for direct firmware inclusion
pkgdesc="Moorechip RP3 Plus firmware (direct inclusion)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"

# Include all firmware files directly
source="
	EXEC_KERNEL_IMAGE.bin
	gnssmodem.bin
	SC9600_sharkl5pro_pubcp_modem.dat
	sharkl5pro_pubcp_DM_DSP.bin
	sharkl5pro_pubcp_LTEA_DSP.bin
	sharkl5pro_pubcp_AGCP_DSP.bin
	sharkl5pro_pubcp_CDMA_DSP.bin
	sharkl5pro_cm4.bin
	sharkl5pro_pubcp_customer_deltanv.bin
	sharkl5pro_pubcp_customer_nvitem.bin
	prodnv.img
"

package() {
	# Base firmware package
	mkdir -p "$pkgdir"
}

wcn() {
	pkgdesc="Moorechip RP3 Plus WiFi, Bluetooth and GNSS firmware"
	_fwdir="$subpkgdir"/lib/firmware/postmarketos/sprd

	install -Dm644 "$srcdir"/EXEC_KERNEL_IMAGE.bin "$_fwdir"/wcnmodem.bin
	install -Dm644 "$srcdir"/gnssmodem.bin -t "$_fwdir"
}

modem() {
	pkgdesc="Moorechip RP3 Plus LTE modem firmware"
	_fwdir="$subpkgdir"/lib/firmware/postmarketos/sprd

	install -Dm644 "$srcdir"/SC9600_sharkl5pro_pubcp_modem.dat "$_fwdir"/l_modem.bin
	install -Dm644 "$srcdir"/sharkl5pro_pubcp_customer_deltanv.bin "$_fwdir"/l_deltanv.bin
	install -Dm644 "$srcdir"/sharkl5pro_pubcp_customer_nvitem.bin "$_fwdir"/l_fixnv.bin
	install -Dm644 "$srcdir"/prodnv.img -t "$_fwdir"
}

dsp() {
	pkgdesc="Moorechip RP3 Plus DSP firmware"
	_fwdir="$subpkgdir"/lib/firmware/postmarketos/sprd

	install -Dm644 "$srcdir"/sharkl5pro_pubcp_DM_DSP.bin "$_fwdir"/l_gdsp.bin
	install -Dm644 "$srcdir"/sharkl5pro_pubcp_LTEA_DSP.bin "$_fwdir"/l_ldsp.bin
	install -Dm644 "$srcdir"/sharkl5pro_pubcp_AGCP_DSP.bin "$_fwdir"/l_agdsp.bin
	install -Dm644 "$srcdir"/sharkl5pro_pubcp_CDMA_DSP.bin "$_fwdir"/l_cdsp.bin
	install -Dm644 "$srcdir"/sharkl5pro_cm4.bin "$_fwdir"/pm_sys.bin
}

subpackages="$pkgname-wcn:wcn $pkgname-modem:modem $pkgname-dsp:dsp"


