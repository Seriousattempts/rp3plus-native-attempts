#!/bin/sh
# /sdcard/vir — virpipe and Venus (Vulkan) test runner
# Usage: /sdcard/vir vulkaninfo
#        /sdcard/vir eglinfo
#        /sdcard/vir vkcube

# -------------------------------------------------
# CONFIG
# -------------------------------------------------
APP_NAME="${1##*/}"
TIMESTAMP="$(date +'%Y%m%d_%H%M%S')"
LOG_DIR="/sdcard"
STDOUT_LOG="${LOG_DIR}/vir_${APP_NAME}_${TIMESTAMP}_output.log"

if [ -z "$1" ]; then
    echo "Usage: $0 <command> [args...]"
    exit 1
fi

echo "=========================================================="
echo "[vir] Launching '$*' with VirGL / Venus..."
echo "[vir] Application Output: $STDOUT_LOG"
echo "=========================================================="

(
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:/usr/lib:/lib
    export LIBGL_DRIVERS_PATH=/usr/local/lib/dri

    # Display sockets
    export XDG_RUNTIME_DIR=/tmp/runtime-root
    export WAYLAND_DISPLAY=wayland-0
    export DISPLAY=:0

    # -------------------------------------------------
    # OpenGL / Virpipe Configuration
    # -------------------------------------------------
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=virpipe
    export VIRGL_SERVER_PATH=/tmp/.virgl_test
    export MESA_GL_VERSION_OVERRIDE=4.0
    export MESA_GLSL_VERSION_OVERRIDE=400
    export MESA_GLES_VERSION_OVERRIDE=3.1
    export MESA_NO_ERROR=1

    # -------------------------------------------------
    # Vulkan / Venus Configuration
    # -------------------------------------------------
    # 1. Force Vulkan to use the vtest socket backend (Venus)
    export VN_DEBUG=vtest
    
    # 2. Blindfold Vulkan from the Android Host driver by explicitly 
    #    pointing it ONLY to the Mesa virtio and swrast ICDs.
    #    We use 'ls' to dynamically find the correct architecture JSON name.
    VIRTIO_ICD=$(ls /usr/local/share/vulkan/icd.d/virtio_icd.*.json 2>/dev/null | head -n 1)
    if [ -n "$VIRTIO_ICD" ]; then
        export VK_ICD_FILENAMES="$VIRTIO_ICD"
    else
        echo "[vir] WARNING: virtio_icd.json not found! Did Mesa compile Vulkan 'virtio'?"
    fi

    # 3. Disable all implicit Vulkan layers (prevents the liblsfg-vk.so crash)
    export VK_LOADER_LAYERS_DISABLE=~all~

    # Verbose Debugging
    export LIBGL_DEBUG=verbose
    export EGL_LOG_LEVEL=debug
    # export VK_LOADER_DEBUG=all # Uncomment if vulkaninfo still fails

    echo "----------------------------------------------------------"
    echo "[vir] Environment Diagnostics:"
    echo "      GALLIUM_DRIVER=$GALLIUM_DRIVER"
    echo "      VIRGL_SERVER_PATH=$VIRGL_SERVER_PATH"
    echo "      VK_ICD_FILENAMES=$VK_ICD_FILENAMES"
    echo "      VN_DEBUG=$VN_DEBUG"
    echo "----------------------------------------------------------"

    "$@"
    APP_EXIT_CODE=$?

    echo "=========================================================="
    if [ "$APP_EXIT_CODE" -eq 0 ]; then
        echo "[vir] SUCCESS: Process closed cleanly (Exit 0)"
    else
        echo "[vir] FAILED: Process crashed or aborted (Exit $APP_EXIT_CODE)"
    fi
    echo "=========================================================="
    exit $APP_EXIT_CODE

) 2>&1 | tee "$STDOUT_LOG"