#!/system/bin/sh
# =============================================================================
# alp_gpu.sh — Alpine GPU / Vulkan / Compositor / App Compatibility Matrix
# Target rootfs : /mnt/alpine
# Strace        : /usr/bin/strace (from inside chroot)
# No Debian paths, no Android linker shim
# =============================================================================
set +e
umask 022
export PATH=/usr/bin:/bin:/sbin:/usr/sbin:/system/bin:/system/xbin:/vendor/bin

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
BOOTPARTITION=/dev/block/mmcblk1p1
SDMOUNT=/sdcard
ROOTFS=/mnt/alpine
CHROOTBIN=/usr/bin/chroot

LOGFILE="$SDMOUNT/alp_gpu.log"
SERVICESLOG="$SDMOUNT/alp_gpu_services.log"
HALLOG="$SDMOUNT/alp_gpu_hal.log"
INPUTLOG="$SDMOUNT/alp_gpu_input.log"
TOOLSLOG="$SDMOUNT/alp_gpu_tools.log"
SEATDLOG="$SDMOUNT/alp_gpu_seatd.log"
DBUSLOG="$SDMOUNT/alp_gpu_dbus.log"
VULKANLOG="$SDMOUNT/alp_gpu_vulkan.log"
STRACEDIR="$SDMOUNT/alp_gpu_strace"
TWRPIMAGE="$SDMOUNT/twrp-customv2.img"

ROOTFSENVFILE=/tmp/alp_gpu_rootfsenv.sh
ROOTFSDBUSENV=/tmp/alp_gpu_dbus_session.env
WESTON_LOG=/tmp/alp_gpu_weston.log
WESTON_PID=/tmp/alp_gpu_weston.pid
WESTON_SOCK=wayland-1
WINEPREFIX=/root/.wine

MOUNTWAIT=75
SMWAIT=8
HALSTARTUPWAIT=15
EARLYDAEMONWAIT=3

STARTTIME="$(date +%s)"

# ---------------------------------------------------------------------------
# Bootstrap SD mount and log files
# ---------------------------------------------------------------------------
if ! mount | grep -q "$BOOTPARTITION"; then
    mkdir -p "$SDMOUNT"
    mount -t exfat "$BOOTPARTITION" "$SDMOUNT" 2>/dev/null || \
    mount -t vfat  "$BOOTPARTITION" "$SDMOUNT" 2>/dev/null || true
fi

mkdir -p "$STRACEDIR"
for f in "$LOGFILE" "$SERVICESLOG" "$HALLOG" "$INPUTLOG" "$TOOLSLOG" \
          "$SEATDLOG" "$DBUSLOG" "$VULKANLOG"; do
    : > "$f"
done
exec >> "$LOGFILE" 2>&1

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
_ts() { date '+%H:%M:%S'; }
log()      { printf '[%s] %s\n'         "$(_ts)" "$*"; sync; }
logsection(){ printf '\n[%s] =====================================\n[%s] === %s ===\n[%s] =====================================\n' "$(_ts)" "$(_ts)" "$*" "$(_ts)"; sync; }
logsub()   { printf '\n[%s] --- %s ---\n' "$(_ts)" "$*"; sync; }
logi()     { printf '[%s]     %s\n'     "$(_ts)" "$*"; sync; }
logw()     { printf '[%s] [!] %s\n'     "$(_ts)" "$*"; sync; }
logok()    { printf '[%s] [+] %s\n'     "$(_ts)" "$*"; sync; }
logerr()   { printf '[%s] [x] ERROR: %s\n' "$(_ts)" "$*"; sync; }
logvk()    { printf '[%s] %s\n' "$(_ts)" "$*" | tee -a "$VULKANLOG"; sync; }
logtools() { printf '[%s] %s\n' "$(_ts)" "$*" | tee -a "$TOOLSLOG"; sync; }
logseatd() { printf '[%s] %s\n' "$(_ts)" "$*" | tee -a "$SEATDLOG"; sync; }
logdbus()  { printf '[%s] %s\n' "$(_ts)" "$*" | tee -a "$DBUSLOG"; sync; }
loghal()   { printf '[%s] %s\n' "$(_ts)" "$*" | tee -a "$HALLOG"; sync; }

readfile() { [ -f "$1" ] && cat "$1" 2>/dev/null || echo NA; }

# ---------------------------------------------------------------------------
# chroot exec — Alpine /bin/sh, no shim
# ---------------------------------------------------------------------------
chrootexec() {
    local logfn="$1"; shift
    "$CHROOTBIN" "$ROOTFS" \
        /usr/bin/env -i \
            HOME=/root USER=root LOGNAME=root \
            SHELL=/bin/sh TERM=xterm-256color \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games \
        /bin/sh -lc "$*" 2>&1 | while IFS= read -r l; do "$logfn" "$l"; done
    return "${PIPESTATUS[0]:-$?}"
}

# chroot exec with strace (uses Alpine's /usr/bin/strace inside chroot)
chrootstrace() {
    local label="$1" outbase="$2"; shift 2
    local stout="$STRACEDIR/${outbase}.strace"
    "$CHROOTBIN" "$ROOTFS" \
        /usr/bin/env -i \
            HOME=/root USER=root LOGNAME=root \
            SHELL=/bin/sh TERM=xterm-256color \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games \
        /bin/sh -lc "/usr/bin/strace -ff -tt -s 256 -o '$stout' $* 2>&1" \
        2>&1 | while IFS= read -r l; do logtools "$l"; done
    logtools "strace[$label] output: $stout"
}

# ---------------------------------------------------------------------------
# Write rootfs environment (no shim, Alpine-native paths)
# ---------------------------------------------------------------------------
write_rootfs_env() {
    mkdir -p "$ROOTFS/tmp" 2>/dev/null || true
    cat > "$ROOTFS$ROOTFSENVFILE" << 'ENVEOF'
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games
export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/vendor/lib64:/vendor/lib64/egl:/vendor/lib64/hw:/system/lib64:/system/system/lib64
export VK_ICD_FILENAMES=/etc/vulkan/icd.d/mali_icd.aarch64.json
export VK_LAYER_PATH=/usr/local/share/vulkan/implicit_layer.d:/usr/share/vulkan/implicit_layer.d
export EGL_VENDOR_LIBRARY_DIRS=/usr/local/share/glvnd/egl_vendor.d:/usr/share/glvnd/egl_vendor.d
export XDG_RUNTIME_DIR=/run/user/0
export WAYLAND_DISPLAY=wayland-1
export WINEPREFIX=/root/.wine
mkdir -p /run /run/dbus /run/user/0 /tmp 2>/dev/null || true
chmod 700 /run/user/0 2>/dev/null || true
[ -f /tmp/alp_gpu_dbus_session.env ] && . /tmp/alp_gpu_dbus_session.env 2>/dev/null || true
ENVEOF
}

# ---------------------------------------------------------------------------
# Hardware status
# ---------------------------------------------------------------------------
hardware_status() {
    logsub "Hardware Status"
    # Use /proc/meminfo so we are independent of toybox vs GNU free layout
    if [ -r /proc/meminfo ]; then
        MEMTOTAL_KB=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
        MEMFREE_KB=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)
        [ -z "$MEMFREE_KB" ] && MEMFREE_KB=$(awk '/MemFree:/ {print $2}' /proc/meminfo)
        USED_KB=$((MEMTOTAL_KB - MEMFREE_KB))
        TOTAL_GB=$(printf '%.2f' "$(echo "$MEMTOTAL_KB / 1048576" | bc -l)")
        USED_GB=$(printf '%.2f' "$(echo "$USED_KB / 1048576" | bc -l)")
        FREE_GB=$(printf '%.2f' "$(echo "$MEMFREE_KB / 1048576" | bc -l)")
        PCT=$(printf '%.1f' "$(echo "100 * $USED_KB / $MEMTOTAL_KB" | bc -l)")
        logi "  RAM: Total ${TOTAL_GB}GB  Used ${USED_GB}GB  Free ${FREE_GB}GB  (${PCT}%)"
    fi
    UPTIMES=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
    logi "Uptime: $((UPTIMES/86400))d $((UPTIMES%86400/3600))h $((UPTIMES%3600/60))m"
    logi "Load:   $(awk '{print $1,$2,$3}' /proc/loadavg 2>/dev/null)"
    BATTCAP="$(readfile /sys/class/power_supply/battery/capacity)"
    BATTSTAT="$(readfile /sys/class/power_supply/battery/status)"
    logi "Battery: $BATTCAP% ($BATTSTAT)"
    log ""
}

# ---------------------------------------------------------------------------
# Device node checks
# ---------------------------------------------------------------------------
dev_checks() {
    logsection "BASIC DEVICE NODE CHECKS"
    [ -e /dev/ptmx ] || { mknod -m 666 /dev/ptmx c 5 2 2>/dev/null && logok "created /dev/ptmx" || logw "could not create /dev/ptmx"; }
    [ -e /dev/ptmx ] && logi "/dev/ptmx exists: $(ls -l /dev/ptmx 2>/dev/null)"
    [ -e /dev/tty  ] && logi "/dev/tty:  $(ls -l /dev/tty 2>/dev/null)"   || logw "/dev/tty absent"
    ls /dev/tty[0-9]* 2>/dev/null | head -5 | while read -r t; do logi "  $t"; done
    if [ -d /dev/dri ]; then
        ls -la /dev/dri 2>/dev/null | while read -r l; do logi "  $l"; done
    else
        logw "/dev/dri not present"
    fi
    log ""
}

# ---------------------------------------------------------------------------
# Early seatd + dbus (host side)
# ---------------------------------------------------------------------------
start_daemons() {
    logsection "EARLY SEATD + DBUS STARTUP"
    mkdir -p /run /run/dbus /run/seatd /run/user/0 2>/dev/null || true
    chmod 755 /run /run/dbus /run/seatd 2>/dev/null || true
    chmod 700 /run/user/0 2>/dev/null || true

    # seatd
    if pgrep -x seatd >/dev/null 2>&1; then
        logseatd "seatd already running"
    else
        SEATDBIN=""
        ALPINE="${ROOTFS:-/mnt/alpine}"
        for p in /usr/sbin/seatd /usr/bin/seatd /sbin/seatd "${ALPINE}/usr/sbin/seatd" "${ALPINE}/usr/bin/seatd"; do
            [ -x "$p" ] && { SEATDBIN="$p"; break; }
        done
        if [ -n "$SEATDBIN" ]; then
            logseatd "Starting: $SEATDBIN -g video"
            "$SEATDBIN" -g video > "$SDMOUNT/alp_gpu_seatd.raw.log" 2>&1 &
            sleep "$EARLYDAEMONWAIT"
            pgrep -x seatd >/dev/null 2>&1                 && logseatd "seatd running PID $(pgrep -x seatd | head -1)"                 || logseatd "seatd failed — check $SDMOUNT/alp_gpu_seatd.raw.log"
        else
            logseatd "seatd binary not found (searched host + $ALPINE)"
        fi
    fi

    # host dbus
    if [ -S /run/dbus/system_bus_socket ]; then
        logdbus "system dbus socket already present"
    else
        DBUSBIN=""
        for p in /usr/bin/dbus-daemon /bin/dbus-daemon; do
            [ -x "$p" ] && ! echo "$p" | grep -q "$ROOTFS" && { DBUSBIN="$p"; break; }
        done
        if [ -n "$DBUSBIN" ]; then
            logdbus "Starting host dbus: $DBUSBIN --system --fork --nopidfile"
            "$DBUSBIN" --system --fork --nopidfile > "$SDMOUNT/alp_gpu_dbus_system.raw.log" 2>&1
            sleep "$EARLYDAEMONWAIT"
            [ -S /run/dbus/system_bus_socket ] \
                && logdbus "host dbus system socket ready" \
                || logdbus "host dbus did not create system socket"
        else
            logdbus "host dbus-daemon not available; will start inside chroot"
        fi
    fi

    export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
    logdbus "DBUS_SYSTEM_BUS_ADDRESS=$DBUS_SYSTEM_BUS_ADDRESS"

    DBUSLAUNCH=""
    for p in /usr/bin/dbus-launch /bin/dbus-launch; do
        [ -x "$p" ] && ! echo "$p" | grep -q "$ROOTFS" && { DBUSLAUNCH="$p"; break; }
    done
    if [ -n "$DBUSLAUNCH" ]; then
        eval "$("$DBUSLAUNCH" 2>"$SDMOUNT/alp_gpu_dbuslaunch.raw.log")" 2>/dev/null || true
        export DBUS_SESSION_BUS_ADDRESS
        logdbus "host session bus: ${DBUS_SESSION_BUS_ADDRESS:-(unset)}"
    else
        logdbus "host dbus-launch not available; session bus will start in chroot"
    fi
    log ""
}

# ---------------------------------------------------------------------------
# Input device enumeration
# ---------------------------------------------------------------------------
input_devices() {
    logsection "INPUT DEVICE ENUMERATION"
    for dev in /dev/input/event*; do
        [ -e "$dev" ] || continue
        name="$(basename "$dev")"
        sp="/sys/class/input/${name}/device"
        logw "Device: $dev"
        logi "  Name: $(cat "${sp}/name" 2>/dev/null || echo unknown)"
        [ -r "$dev" ] && logi "  readable: yes" || logw "  readable: NO"
    done
    logok "Input enumeration complete"
    log ""
}

# ---------------------------------------------------------------------------
# Android service managers
# ---------------------------------------------------------------------------
android_service_managers() {
    logsection "ANDROID SERVICE MANAGERS"
    GREP="$(command -v grep || echo grep)"
    for mgr in servicemanager hwservicemanager; do
        logsub "$mgr"
        if ps -A 2>/dev/null | "$GREP" -v grep | "$GREP" -q "$mgr"; then
            logok "$mgr already running"
        else
            BIN=""
            for p in /bin/$mgr /system/bin/$mgr; do
                [ -x "$p" ] && { BIN="$p"; break; }
            done
            if [ -n "$BIN" ]; then
                logi "Starting $BIN"
                "$BIN" >/dev/null 2>&1 &
                sleep "$SMWAIT"
                ps -A 2>/dev/null | "$GREP" -v grep | "$GREP" -q "$mgr" \
                    && logok "$mgr running PID $(pgrep "$mgr" 2>/dev/null | head -1)" \
                    || logw "$mgr not detected after start"
            else
                logw "$mgr binary not found"
            fi
        fi
        log ""
    done
}

# ---------------------------------------------------------------------------
# Android HAL services
# ---------------------------------------------------------------------------
android_hal_services() {
    logsection "ANDROID HAL SERVICES"

    cat << 'HALEND' | while IFS='|' read -r NAME BIN; do
HIDLMemoryAllocator|/system/bin/hw/android.hidl.allocator@1.0-service
AudioHAL|/vendor/bin/hw/android.hardware.audio.service
BluetoothHAL|/vendor/bin/hw/android.hardware.bluetooth@1.1-service.unisoc
WiFiHAL|/vendor/bin/hw/android.hardware.wifi@1.0-service
GraphicsAllocator|/vendor/bin/hw/android.hardware.graphics.allocator@4.0-service
GraphicsComposer|/vendor/bin/hw/android.hardware.graphics.composer@2.1-service
HealthHAL|/vendor/bin/hw/android.hardware.health@2.1-service
ThermalHAL|/vendor/bin/hw/vendor.sprd.hardware.thermal@2.0-service
HALEND
        [ -z "$NAME" ] && continue
        logsub "$NAME"
        if [ -x "$BIN" ]; then
            "$BIN" >/dev/null 2>&1 &
            PID=$!
            sleep "$HALSTARTUPWAIT"
            ps -p "$PID" >/dev/null 2>&1                 && loghal "$NAME running PID $PID"                 || loghal "$NAME failed or already handled by Android init"
        else
            loghal "$NAME binary not found: $BIN"
        fi
        log ""
    done

    logsection "HAL REGISTRATION CHECK"
    if command -v lshal >/dev/null 2>&1; then
        lshal 2>/dev/null | tee -a "$HALLOG" | while read -r l; do log "$l"; done
        logok "HAL services registered: $(lshal 2>/dev/null | grep -c 'android.hardware' || echo 0)"
    else
        logw "lshal not found"
    fi
    log ""
}

# ---------------------------------------------------------------------------
# Bind mounts into chroot
# ---------------------------------------------------------------------------
bind_mounts() {
    logsection "CHROOT BIND MOUNTS"
    logvk "Binding into $ROOTFS"

    # Mandatory pseudo-filesystems
    for d in proc sys dev dev/pts; do
        mkdir -p "$ROOTFS/$d"
        if grep -q " $ROOTFS/$d " /proc/mounts 2>/dev/null; then
            logvk "  [·] already bound: $d"
        else
            mount --bind "/$d" "$ROOTFS/$d" 2>/dev/null \
                && logvk "  [+] bound: $d" \
                || logw  "  [!] failed bind: $d"
        fi
    done

    # Optional Android partitions
    for d in vendor system linkerconfig sdcard apex odm product system_ext; do
        [ -d "/$d" ] || continue
        mkdir -p "$ROOTFS/$d"
        grep -q " $ROOTFS/$d " /proc/mounts 2>/dev/null && continue
        mount --bind "/$d" "$ROOTFS/$d" 2>/dev/null \
            && logvk "  [+] bound: $d" \
            || logvk "  [·] skipped (may not exist): $d"
    done

    # Recovery assets kept read-only
    for d in twrp realrecovery; do
        [ -d "/$d" ] || continue
        mkdir -p "$ROOTFS/$d"
        grep -q " $ROOTFS/$d " /proc/mounts 2>/dev/null && continue
        mount --bind "/$d" "$ROOTFS/$d" 2>/dev/null \
            && logvk "  [+] bound: $d (recovery)" \
            || logvk "  [·] $d not found on host"
    done
    log ""
}

unbind_mounts() {
    logsection "CHROOT UNBIND"
    for d in realrecovery twrp odm product system_ext apex sdcard dev/pts dev proc sys vendor system linkerconfig; do
        umount "$ROOTFS/$d" 2>/dev/null && logvk "  unbound: $ROOTFS/$d" || true
    done
    log ""
}

# ---------------------------------------------------------------------------
# ld.config.txt
# ---------------------------------------------------------------------------
probe_ld_config() {
    logsection "LD.CONFIG.TXT VERIFICATION"
    LDCONFIGSRC=""
    for src in "$ROOTFS/home/ld.config.txt" "$ROOTFS/root/ld.config.txt" "$ROOTFS/etc/ld.config.txt"; do
        [ -f "$src" ] && { LDCONFIGSRC="$src"; break; }
    done

    if [ -n "$LDCONFIGSRC" ]; then
        cp -f "$LDCONFIGSRC" /linkerconfig/ld.config.txt 2>/dev/null \
            && logok "Copied $LDCONFIGSRC -> /linkerconfig/ld.config.txt" \
            || logerr "Copy failed"
    else
        logerr "ld.config.txt not found in rootfs"
    fi

    if [ -f /linkerconfig/ld.config.txt ] && [ ! -L /linkerconfig/ld.config.txt ]; then
        logok "/linkerconfig/ld.config.txt is a regular file"
        head -30 /linkerconfig/ld.config.txt | while read -r l; do logi "  $l"; done
    fi

    if [ -f "$ROOTFS/linkerconfig/ld.config.txt" ]; then
        logok "ld.config.txt reachable inside chroot"
    else
        logw "ld.config.txt NOT visible inside chroot"
    fi

    chrootexec logvk "ldconfig >/tmp/alp_gpu_ldconfig.log 2>&1 && echo 'ldconfig OK' || { echo 'ldconfig FAILED'; tail -20 /tmp/alp_gpu_ldconfig.log; }"
    log ""
}

# ---------------------------------------------------------------------------
# Rootfs dbus startup (inside chroot)
# ---------------------------------------------------------------------------
start_rootfs_dbus() {
    logsection "ROOTFS DBUS STARTUP"
    write_rootfs_env
    chrootexec logdbus ". $ROOTFSENVFILE
        mkdir -p /run /run/dbus /run/user/0 /var/lib/dbus /etc 2>/dev/null || true
        chmod 755 /run /run/dbus 2>/dev/null || true
        chmod 700 /run/user/0 2>/dev/null || true
        command -v dbus-uuidgen >/dev/null 2>&1 && {
            dbus-uuidgen --ensure=/etc/machine-id >/dev/null 2>&1 || true
            dbus-uuidgen --ensure=/var/lib/dbus/machine-id >/dev/null 2>&1 || true
        }
        if [ -S /run/dbus/system_bus_socket ]; then
            echo 'rootfs system dbus socket already present'
        elif [ -x /etc/init.d/dbus ]; then
            /etc/init.d/dbus start >/tmp/alp_gpu_dbus_init.log 2>&1 || true; sleep 2
        elif command -v dbus-daemon >/dev/null 2>&1; then
            dbus-daemon --system --fork --nopidfile >/tmp/alp_gpu_dbus_system.log 2>&1 || true; sleep 2
        fi
        [ -S /run/dbus/system_bus_socket ] && echo 'rootfs system dbus is up' || echo 'rootfs system dbus is NOT up'
        if command -v dbus-launch >/dev/null 2>&1; then
            dbus-launch --sh-syntax > $ROOTFSDBUSENV 2>/tmp/alp_gpu_dbus_launch.err || true
            sed -n '1,10p' $ROOTFSDBUSENV 2>/dev/null || true
        else
            echo 'dbus-launch missing in rootfs'
        fi"
    log ""
}

# ---------------------------------------------------------------------------
# Init.d inventory
# ---------------------------------------------------------------------------
probe_initd() {
    logsection "ROOTFS INIT.D INVENTORY"
    if [ -d "$ROOTFS/etc/init.d" ]; then
        for svc in "$ROOTFS/etc/init.d/"*; do
            [ -f "$svc" ] && logok "init.d: /etc/init.d/$(basename "$svc")"
        done
    else
        logw "No $ROOTFS/etc/init.d directory"
    fi
    log ""
}

# ---------------------------------------------------------------------------
# Alpine graphical stack inventory
# ---------------------------------------------------------------------------
probe_graphical_stack() {
    logsection "ALPINE GRAPHICAL STACK INVENTORY"
    logvk "Rootfs: $ROOTFS"

    logsub "Compositor binaries"
    for b in \
        /usr/bin/weston /usr/local/bin/weston \
        /usr/bin/Xwayland \
        /usr/games/gamescope /usr/bin/gamescope \
        /usr/bin/mir-x11-kiosk /usr/bin/mir-x11-kiosk-launch \
        /usr/bin/miral-app /usr/bin/miral-kiosk \
        /usr/bin/miral-shell /usr/bin/miral-system-compositor \
        /usr/bin/miral-terminal /usr/bin/mir-wayland-generator
    do
        [ -e "$ROOTFS$b" ] && logvk "  [+] $b  $(ls -lh "$ROOTFS$b" 2>/dev/null | awk '{print $5}')" \
                           || logvk "  [·] missing $b"
    done

    logsub "Weston version"
    WESTBIN=""
    [ -x "$ROOTFS/usr/local/bin/weston" ] && WESTBIN=/usr/local/bin/weston
    [ -x "$ROOTFS/usr/bin/weston"       ] && WESTBIN=/usr/bin/weston
    [ -n "$WESTBIN" ] && chrootexec logvk "$WESTBIN --version 2>&1 | head -3" || logvk "weston not found"

    logsub "Vulkan loader"
    for f in \
        /usr/lib/libvulkan.so \
        /usr/lib/libvulkan.so.1 \
        /usr/local/lib/libvulkan.so \
        /usr/local/lib/libvulkan.so.1
    do
        [ -e "$ROOTFS$f" ] && logvk "  [+] $f -> $(readlink -f "$ROOTFS$f" 2>/dev/null)  $(ls -lh "$ROOTFS$f" 2>/dev/null | awk '{print $5}')"
    done

    logsub "Mali ICD JSONs"
    for icd in \
        /etc/vulkan/icd.d/mali_icd.aarch64.json \
        /etc/vulkan/icd.d/mali_icd.json
    do
        if [ -f "$ROOTFS$icd" ]; then
            logvk "  [+] $icd"
            cat "$ROOTFS$icd" | while read -r l; do logvk "      $l"; done
        else
            logvk "  [·] missing $icd"
        fi
    done
    MALIREAL="$(readlink -f /vendor/lib64/hw/vulkan.ums512.so 2>/dev/null)"
    [ -n "$MALIREAL" ] && [ -e "$MALIREAL" ] \
        && logvk "  [+] vendor Mali blob: $MALIREAL  $(stat -c%s "$MALIREAL" 2>/dev/null) bytes" \
        || logvk "  [!] vendor Mali blob not resolved"

    logsub "Implicit Vulkan layers"
    for dir in \
        /usr/local/share/vulkan/implicit_layer.d \
        /usr/share/vulkan/implicit_layer.d
    do
        [ -d "$ROOTFS$dir" ] || continue
        for j in "$ROOTFS$dir/"*.json; do
            [ -f "$j" ] || continue
            lname="$(python3 -c "import json,sys; d=json.load(open('$j')); print(d.get('layer',{}).get('name','?'))" 2>/dev/null || echo "?")"
            logvk "  [+] $dir/$(basename "$j")  name=$lname"
        done
    done

    logsub "Mesa / EGL / GLES libraries"
    for f in \
        /usr/lib/libGL.so* \
        /usr/lib/libEGL.so* \
        /usr/lib/libGLES*.so* \
        /usr/lib/libgbm.so*
    do
        ls -lh "$ROOTFS$f" 2>/dev/null | while read -r l; do logvk "  $l"; done
    done

    logsub "Wayland libraries"
    for lib in libwayland-client libwayland-server libwayland-egl; do
        found="$(find "$ROOTFS/usr/lib" "$ROOTFS/usr/local/lib" -name "${lib}.so*" 2>/dev/null | sort)"
        if [ -n "$found" ]; then
            logvk "  [+] $lib"
            echo "$found" | while read -r wf; do logvk "      $(ls -lh "$wf" 2>/dev/null | awk '{print $5,$9}')"; done
        else
            logvk "  [!] $lib not found"
        fi
    done

    logsub "Input / session libraries"
    for f in \
        /usr/lib/libinput.so* \
        /usr/lib/libseat.so* \
        /usr/lib/libevdev.so* \
        /usr/lib/libxkbcommon.so*
    do
        ls -lh "$ROOTFS$f" 2>/dev/null | while read -r l; do logi "  $l"; done
    done

    logsub "Profile.d hooks"
    for f in \
        "$ROOTFS/etc/profile.d/vulkan.sh" \
        "$ROOTFS/etc/profile.d/mali_vulkan.sh" \
