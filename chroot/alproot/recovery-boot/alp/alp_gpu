# ---------------------------------------------------------------------------
# dlopen probe (compiled inside chroot)
# ---------------------------------------------------------------------------
probe_dlopen() {
    logsection "DLOPEN PROBE"
    PROBESRC="$ROOTFS/tmp/dlopen_probe.c"
    PROBEBIN="$ROOTFS/tmp/dlopen_probe"

    cat > "$PROBESRC" << 'CSRC'
#include <dlfcn.h>
#include <stdio.h>
static const char *libs[]={
  "libvulkan.so.1",
  "/usr/local/share/vulkan/implicit_layer.d/libVkLayer_window_system_integration.so",
  "/usr/lib/libEGL.so",
  "/usr/lib/libGL.so",
  "/usr/lib/libgbm.so",
  "libwayland-client.so.0",
  "libwayland-server.so.0",
  "libwayland-egl.so.1",
  NULL
};
int main(void){
  int ok=0,fail=0;
  for(int i=0;libs[i];i++){
    void*h=dlopen(libs[i],RTLD_LAZY|RTLD_LOCAL);
    if(h){printf("OK   %s\n",libs[i]);dlclose(h);ok++;}
    else {printf("FAIL %s -- %s\n",libs[i],dlerror());fail++;}
  }
  printf("dlopen summary: %d OK, %d FAILED\n",ok,fail);
  return fail?1:0;
}
CSRC

    if [ -x "$ROOTFS/usr/bin/gcc" ] || [ -x "$ROOTFS/usr/bin/cc" ]; then
        logvk "Compiling dlopen probe..."
        chrootexec logvk ". $ROOTFSENVFILE
cd /tmp
gcc -o dlopen_probe dlopen_probe.c -ldl 2>/dev/null || cc -o dlopen_probe dlopen_probe.c -ldl 2>&1 || echo 'compile failed'"
        if [ -x "$PROBEBIN" ]; then
            chrootstrace "dlopen" "dlopen_probe" ". $ROOTFSENVFILE /tmp/dlopen_probe"
        fi
    else
        logw "gcc/cc not present in Alpine rootfs — skipping dlopen compile"
    fi
    rm -f "$PROBESRC" "$PROBEBIN" 2>/dev/null || true
    log ""
}

