# ---------------------------------------------------------------------------
# Compositor start / stop helpers
# ---------------------------------------------------------------------------
start_compositor() {
    cname="$1"; ccmd="$2"; sock="$3"; envvars="$4"
    logsub "Starting compositor: $cname"
    chrootexec logvk ". $ROOTFSENVFILE
mkdir -p /tmp/alp_gpu_compositors /run/user/0 2>/dev/null || true
chmod 700 /run/user/0 2>/dev/null || true
rm -f /tmp/alp_gpu_compositors/${cname}.pid /tmp/alp_gpu_compositors/${cname}.sock
export $envvars
nohup $ccmd >/tmp/alp_gpu_compositors/${cname}.stdout 2>&1 &
echo \$! > /tmp/alp_gpu_compositors/${cname}.pid
sleep 8
[ -S '${sock}' ] && echo 'COMPOSITOR_READY: ${cname}  socket: ${sock}' || echo 'COMPOSITOR_NOT_READY: ${cname}'
tail -n 60 /tmp/alp_gpu_compositors/${cname}.stdout 2>/dev/null || true"
    log ""
}

stop_compositor() {
    cname="$1"
    chrootexec logvk "
PID=\$(cat /tmp/alp_gpu_compositors/${cname}.pid 2>/dev/null)
[ -n \"\$PID\" ] && { kill \$PID 2>/dev/null; sleep 2; kill -9 \$PID 2>/dev/null; } || true
echo '${cname} stopped'"
}

# ---------------------------------------------------------------------------
# App matrix — run a set of apps under a given display environment
# ---------------------------------------------------------------------------
run_app_matrix() {
    compositorname="$1"; display_envvars="$2"; layer_envvars="$3"
    logsub "APP MATRIX: $compositorname"

    _app() {
        local appname="$1"; local appcmd="$2"
        logsub "  APP $appname @ $compositorname"
        chrootstrace "${compositorname}_${appname}" \
            "appmatrix_${compositorname}_$(echo "$appname" | tr '/ ' '__')" \
            ". $ROOTFSENVFILE
             export $display_envvars
             export $layer_envvars
             VK_ICD_FILENAMES=/etc/vulkan/icd.d/mali_icd.aarch64.json
             $appcmd" \
        2>&1 | while IFS= read -r l; do logtools "$l"; done
        log ""
    }

    _app "retroarch"   "command -v retroarch >/dev/null 2>&1 && timeout 8 retroarch --version 2>&1 | head -5 || echo 'retroarch missing'"
    _app "firefox"     "command -v firefox >/dev/null 2>&1 && timeout 8 firefox --version 2>&1 | head -3 || { command -v firefox-esr >/dev/null 2>&1 && timeout 8 firefox-esr --version 2>&1 | head -3; } || echo 'firefox missing'"
    _app "lutris"      "command -v lutris >/dev/null 2>&1 && timeout 8 lutris --version 2>&1 | head -3 || echo 'lutris missing'"
    _app "obs"         "command -v obs >/dev/null 2>&1 && obs --version 2>&1 | head -3 || echo 'obs missing'"
    _app "obs-ffmpeg-mux" "command -v obs-ffmpeg-mux >/dev/null 2>&1 && obs-ffmpeg-mux --help 2>&1 | head -5 || echo 'obs-ffmpeg-mux missing'"
    _app "wine"        "command -v wine >/dev/null 2>&1 && wine --version 2>&1 | head -3 || echo 'wine missing'"
    _app "wineconsole" "command -v wineconsole >/dev/null 2>&1 && wineconsole --version 2>&1 | head -3 || echo 'wineconsole missing'"
    _app "winecfg"     "command -v winecfg >/dev/null 2>&1 && timeout 6 winecfg 2>&1 | head -5 || echo 'winecfg missing'"
    _app "vkcube"      "command -v vkcube >/dev/null 2>&1 && timeout 8 vkcube 2>&1 | head -30 || echo 'vkcube missing'"
    _app "vkcubepp"    "command -v vkcubepp >/dev/null 2>&1 && timeout 8 vkcubepp 2>&1 | head -30 || echo 'vkcubepp missing'"
    _app "vulkaninfo"  "command -v vulkaninfo >/dev/null 2>&1 && vulkaninfo --summary 2>&1 | head -40 || echo 'vulkaninfo missing'"
    _app "virglrenderer" "command -v virgltestserver >/dev/null 2>&1 && timeout 6 virgltestserver --help 2>&1 | head -10 || echo 'virgltestserver missing'"

    # QEMU variants
    for q in qemu-system-aarch64 qemu-system-arm qemu-system-x86_64 \
              qemu-aarch64 qemu-arm qemu-x86_64 qemu-img qemu-io \
              qemu-storage-daemon qemu-nbd qemu-edid qemu-keymap qemu-microblazeel; do
        _app "$q" "command -v $q >/dev/null 2>&1 && $q --version 2>&1 | head -5 || echo 'missing: $q'"
    done
}

# ---------------------------------------------------------------------------
# Compositor + app compatibility matrix
# ---------------------------------------------------------------------------
probe_compositor_matrix() {
    logsection "COMPOSITOR + APP COMPATIBILITY MATRIX"

    ALL_LAYERS="VK_LAYER_PATH=$VK_LAYER_DIRS VK_LOADER_DEBUG=all"

    # ── Weston (headless Vulkan) ──────────────────────────────────────────
    start_compositor \
        "weston" \
        "/usr/bin/weston --backend=headless --renderer=vulkan --socket=wayland-1 --idle-time=0 --log=/tmp/alp_gpu_compositors/weston.log" \
        "/run/user/0/wayland-1" \
        "XDG_RUNTIME_DIR=/run/user/0 VK_ICD_FILENAMES=/etc/vulkan/icd.d/mali_icd.aarch64.json $ALL_LAYERS"

    run_app_matrix "weston" \
        "XDG_RUNTIME_DIR=/run/user/0 WAYLAND_DISPLAY=wayland-1" \
        "$ALL_LAYERS"
    stop_compositor "weston"

    # ── Weston fallback (headless DRM) ───────────────────────────────────
    start_compositor \
        "weston_drm" \
        "/usr/bin/weston --backend=drm --socket=wayland-1 --idle-time=0 --log=/tmp/alp_gpu_compositors/weston_drm.log" \
        "/run/user/0/wayland-1" \
        "XDG_RUNTIME_DIR=/run/user/0 $ALL_LAYERS"
    run_app_matrix "weston_drm" \
        "XDG_RUNTIME_DIR=/run/user/0 WAYLAND_DISPLAY=wayland-1" \
        "$ALL_LAYERS"
    stop_compositor "weston_drm"

    # ── Mir launchers ─────────────────────────────────────────────────────
    for mir_bin in \
        "/usr/bin/mir-x11-kiosk" \
        "/usr/bin/miral-kiosk" \
        "/usr/bin/miral-shell" \
        "/usr/bin/miral-system-compositor"
    do
        mir_name="$(basename "$mir_bin" | tr '-' '_')"
        if [ -x "$ROOTFS$mir_bin" ]; then
            start_compositor \
                "$mir_name" \
                "$mir_bin" \
                "/run/user/0/wayland-0" \
                "XDG_RUNTIME_DIR=/run/user/0 $ALL_LAYERS"
            run_app_matrix "$mir_name" \
                "XDG_RUNTIME_DIR=/run/user/0 WAYLAND_DISPLAY=wayland-0" \
                "$ALL_LAYERS"
            stop_compositor "$mir_name"
        else
            logw "Skipping compositor (missing): $mir_bin"
        fi
    done

    # ── Gamescope (steam) ─────────────────────────────────────────────────
    GSBIN=""
    [ -x "$ROOTFS/usr/bin/gamescope"   ] && GSBIN=/usr/bin/gamescope
    [ -x "$ROOTFS/usr/games/gamescope" ] && GSBIN=/usr/games/gamescope
    if [ -n "$GSBIN" ]; then
        start_compositor \
            "gamescope" \
            "$GSBIN -W 1280 -H 720 -r 60 --backend wayland -- /bin/true" \
            "/run/user/0/wayland-0" \
            "XDG_RUNTIME_DIR=/run/user/0 $ALL_LAYERS"
        run_app_matrix "gamescope" \
            "XDG_RUNTIME_DIR=/run/user/0 WAYLAND_DISPLAY=wayland-0" \
            "$ALL_LAYERS"
        stop_compositor "gamescope"
    else
        logw "gamescope binary not found — skipping compositor"
    fi

    # ── XWayland probe (standalone, no compositor) ────────────────────────
    logsub "Xwayland probe (standalone)"
    chrootstrace "xwayland_probe" "xwayland_probe" \
        ". $ROOTFSENVFILE; Xwayland -version 2>&1 | head -20"

    # ── Mesa library sanity ───────────────────────────────────────────────
    logsub "Mesa library sanity"
    chrootexec logvk ". $ROOTFSENVFILE
for f in /usr/lib/libGL.so* /usr/lib/libEGL.so* /usr/lib/libGLES*.so* /usr/lib/libgbm.so*; do
    ls -lh \$f 2>/dev/null || true
done"

    # ── Miral desktop file ────────────────────────────────────────────────
    logsub "miral-shell.desktop"
    [ -f "$ROOTFS/usr/share/applications/miral-shell.desktop" ] \
        && cat "$ROOTFS/usr/share/applications/miral-shell.desktop" | while read -r l; do logi "  $l"; done \
        || logw "miral-shell.desktop missing"

    log ""
}

# ---------------------------------------------------------------------------
