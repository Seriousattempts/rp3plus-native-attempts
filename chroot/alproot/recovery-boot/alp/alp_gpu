probe_opt_payloads() {
    logsection "OPT PAYLOAD SCAN"
    if [ ! -d "$ROOTFS/opt" ]; then
        logw "No $ROOTFS/opt directory"
        return 0
    fi

    for sub in "$ROOTFS/opt/"*/; do
        [ -d "$sub" ] || continue
        name="$(basename "$sub")"
        logsub "opt/$name"
        EXE="$(find "$sub" -maxdepth 3 \( -iname '*.exe' -o -iname '*.EXE' \) 2>/dev/null | head -1)"
        APPRUN=""; [ -x "${sub}AppRun" ] && APPRUN="/opt/${name}/AppRun"
        DESKTOP="$(find "$sub" -maxdepth 2 -name '*.desktop' 2>/dev/null | head -1)"

        if [ -n "$EXE" ]; then
            relexe="${EXE#"$ROOTFS"}"
            logok "Found .exe: $relexe"
            for runner in wine wine-stable; do
                chrootstrace "opt_${name}_${runner}" "opt_${name}_${runner}" \
                    ". $ROOTFSENVFILE; command -v $runner >/dev/null 2>&1 && timeout 12 $runner $relexe || echo '$runner not available'"
            done
            chrootstrace "opt_${name}_box64wine" "opt_${name}_box64wine" \
                ". $ROOTFSENVFILE; command -v box64 >/dev/null 2>&1 && command -v wine >/dev/null 2>&1 \
                 && timeout 12 box64 \$(command -v wine) $relexe || echo 'box64+wine not available'"
        elif [ -n "$APPRUN" ]; then
            logok "Found AppRun: $APPRUN  desktop: $(basename "$DESKTOP")"
            chrootstrace "opt_${name}_apprun" "opt_${name}_apprun" \
                ". $ROOTFSENVFILE; cd /opt/$name && timeout 12 ./AppRun --help 2>&1 | head -30 || timeout 12 ./AppRun 2>&1 | head -30"
        else
            logi "No .exe or AppRun in /opt/$name"
        fi
    done
    log ""
}

# ---------------------------------------------------------------------------
# TWRP flash
# ---------------------------------------------------------------------------
twrp_partitions() {
    logsection "FLASHING TWRP"
    if [ ! -f "$TWRPIMAGE" ]; then
        logerr "TWRP image not found: $TWRPIMAGE"
        return 1
    fi
    logi "Image: $TWRPIMAGE  ($(stat -c%s "$TWRPIMAGE" 2>/dev/null || echo ?) bytes)"
    for part in /dev/block/mmcblk0p42 /dev/block/mmcblk0p43; do
        logsub "Flashing $part"
        if [ -b "$part" ]; then
            dd if="$TWRPIMAGE" of="$part" bs=1048576 2>&1 | while read -r l; do log "$l"; done
            sync
            [ "${PIPESTATUS[0]:-$?}" -eq 0 ] && logok "Flashed $part" || logerr "Failed $part"
        else
            logerr "Not a block device: $part"
        fi
    done
    logok "TWRP flash complete"
    sync
    log ""
}

