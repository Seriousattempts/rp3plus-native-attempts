# ======================================================================
# prop.default - Linux rootfs boot configuration  
# ======================================================================

# Basic system properties
ro.secure=0
ro.adb.secure=0
ro.debuggable=1
ro.allow.mock.location=1

# Hardware identification
ro.product.vendor.brand=UNISOC
ro.product.vendor.device=ums512_1h10
ro.product.vendor.manufacturer=Moorechip
ro.product.vendor.model=Retroid Pocket 3 Plus
ro.product.vendor.name=ums512_1h10_Natv
ro.product.model=Retroid Pocket 3 Plus
ro.product.brand=UNISOC
ro.product.name=ums512_1h10_Natv
ro.product.device=ums512_1h10
ro.vendor.retro.name=3.5

# CPU architecture  
ro.product.cpu.abi=arm64-v8a
ro.product.cpu.abilist=arm64-v8a,armeabi-v7a,armeabi
ro.product.cpu.abilist32=armeabi-v7a,armeabi
ro.product.cpu.abilist64=arm64-v8a
ro.bionic.arch=arm64
ro.bionic.cpu_variant=cortex-a75
ro.bionic.2nd_arch=arm
ro.bionic.2nd_cpu_variant=cortex-a55

# Graphics
ro.minui.pixel_format=RGBX_8888
ro.opengles.version=196610
ro.hwui.use_vulkan=true
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=false
ro.sf.lcd_density=266
ro.sf.lcd_width=54
ro.sf.lcd_height=96
debug.egl.hw=1
debug.sf.hw=1

# USB configuration
sys.usb.controller=musb-hdrc.0.auto
persist.sys.usb.config=adb,mtp

# Linux-specific properties
ro.boot.dynamic_partitions=false
ro.virtual_ab.enabled=false
ro.apex.updatable=false

# Memory management
persist.sys.zram_enabled=1
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=180
ro.config.low_ram=false

# Bluetooth/WiFi
persist.bluetooth.a2dp_offload.disabled=true
ro.vendor.gnsschip=marlin3lite
ro.vendor.wcn.gpschip=marlin3lite
net.bt.name=RP3PLUS
net.hostname=rp3plus-linux
ro.wifi.channels=

# Storage properties
ro.crypto.dm_default_key.options_format.version=2
external_storage.projid.enabled=1
external_storage.casefold.enabled=1
ro.storage.flash_type=2

# Sensor configuration
persist.sys.sensors.hal_trigger=true
ro.vendor.i2c.enable=1
ro.vendor.gpio.enable=1
ro.vendor.i2c.sensors.bus=0,1,2

# Thermal management
ro.vendor.thermal.mitigation=true
persist.sys.thermal.enable=1

# Modem configuration
ro.vendor.modem.dev=/proc/cptl/
ro.vendor.modem.tty=/dev/stty_lte
ro.vendor.modem.eth=seth_lte
ro.vendor.modem.snd=1
ro.vendor.radio.modemtype=l
ro.vendor.modem.diag=/dev/sdiag_lte
ro.vendor.modem.log=/dev/slog_lte
ro.vendor.modem.loop=/dev/spipe_lte0
ro.vendor.modem.nv=/dev/spipe_lte1
ro.vendor.modem.assert=/dev/spipe_lte2
persist.vendor.modem.nvp=l_
persist.vendor.modem.l.enable=1
persist.vendor.radio.phone_count=2
persist.radio.multisim.config=dsds
ro.telephony.default_network=9

# System configuration
persist.sys.timezone=UTC
persist.sys.locale=en-US
qemu.hw.mainkeys=0
ro.config.desktop_mode=true
persist.sys.ui.hw=true
ro.config.ringtone=
ro.config.notification_sound=
ro.config.alarm_alert=
persist.sys.strictmode.disable=true

# Performance properties
persist.sys.pwctl.enable=0
persist.sys.pwctl.guru=0
ro.config.avoid_gfx_accel=false
persist.sys.sf.color_saturation=1.0

# Input device configuration (based on actual hardware testing)
ro.config.hw_quickpoweroff=true
ro.config.hw_power_button=true
persist.sys.input.wake_on_volume=true
persist.sys.input.wake_on_power=true

# Volume/Power button mappings (gpio-keys event2)
persist.sys.keymap.volume_up=115
persist.sys.keymap.volume_down=114
persist.sys.keymap.power=116

# Gaming controller mappings (Retroid Pocket Controller event5)
persist.sys.input.controller.a=304
persist.sys.input.controller.b=305
persist.sys.input.controller.x=307
persist.sys.input.controller.y=308
persist.sys.input.controller.home=102
persist.sys.input.controller.l1=310
persist.sys.input.controller.r1=311
persist.sys.input.controller.l2=312
persist.sys.input.controller.r2=313
persist.sys.input.controller.l3=317
persist.sys.input.controller.r3=318

# Device-specific input properties
persist.sys.input.gpio_keys_device=event2
persist.sys.input.touchscreen_device=event1
persist.sys.input.controller_device=event5

# Gaming controller support
persist.sys.retro.controller.enabled=true
ro.input.noresample=1

# Analog stick configuration (Joystick calibration data)
persist.sys.input.stick.deadzone=15
persist.sys.input.stick.range=32767

# Original Build information
ro.build.type=user
ro.build.date=Tue Jul 4 17:05:04 HKT 2023
ro.build.date.utc=1688461504
ro.build.version.release=11
ro.build.version.sdk=30

# Linux rootfs specific
security.perf_harden=0
