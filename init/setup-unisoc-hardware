#!/bin/sh
# UNISOC Hardware Device Configuration Script
# Configures permissions for all UNISOC-specific and standard devices
# Revamped with ueventd chmod modifications + Halium compatibility

HARDWARE_LOG="/var/log/unisoc_hardware.log"
echo "=== UNISOC Hardware Configuration Started at $(date) ===" > "$HARDWARE_LOG"

hw_log() {
    echo "$(date '+%H:%M:%S') - $1" | tee -a "$HARDWARE_LOG"
}

# Configure device with specific permissions and optional owner:group
configure_device_perm() {
    local device="$1"
    local perm="$2"
    local owner="${3:-root}"
    local group="${4:-root}"
    
    if [ -e "$device" ]; then
        if chmod "$perm" "$device" 2>/dev/null; then
            chown "$owner:$group" "$device" 2>/dev/null
            hw_log "  ✓ Configured: $device ($perm $owner:$group)"
            return 0
        else
            hw_log "  ⚠ Failed: $device (permission denied)"
            return 1
        fi
    fi
    return 2
}

# Devices not in ueventd.rc but shown in adb shell that I'm willing to give full access
configure_device() {
    local device="$1"
    configure_device_perm "$device" "666" "root" "root"
}

configure_device_group() {
    local pattern="$1"
    local description="$2"
    local count=0

    hw_log "Configuring $description..."
    for device in $pattern; do
        if configure_device "$device"; then
            count=$((count + 1))
        fi
    done
    hw_log "  Total configured: $count"
    return $count
}

# Configure device group with specific permissions
configure_device_group_perm() {
    local pattern="$1"
    local perm="$2"
    local owner="$3"
    local group="$4"
    local description="$5"
    local count=0

    hw_log "Configuring $description..."
    for device in $pattern; do
        if configure_device_perm "$device" "$perm" "$owner" "$group"; then
            count=$((count + 1))
        fi
    done
    hw_log "  Total configured: $count"
    return $count
}

# === V4L2 CAMERA INITIALIZATION FUNCTION ===
initialize_v4l2_cameras() {
    hw_log "=== Initializing V4L2 Camera System ==="
    
    # Check if camera modules are loaded
    if ! lsmod | grep -q sprd_sensor; then
        hw_log "  ⚠ sprd_sensor module not loaded, attempting to load..."
        modprobe sprd_sensor 2>/dev/null || insmod /vendor/lib/modules/sprd_sensor.ko 2>/dev/null
        sleep 1
    fi
    
    if ! lsmod | grep -q sprd_cpp; then
        hw_log "  ⚠ sprd_cpp module not loaded, attempting to load..."
        modprobe sprd_cpp 2>/dev/null || insmod /vendor/lib/modules/sprd_cpp.ko 2>/dev/null
        sleep 1
    fi
    
    # Check for camera platform device
    if [ -d /sys/devices/platform/soc/soc:cam-subsys ] || \
       [ -d /sys/devices/platform/camera ] || \
       [ -d /sys/devices/virtual/video4linux ]; then
        hw_log "  ✓ Camera platform device detected"
    else
        hw_log "  ⚠ Camera platform device not found"
    fi
    
    # Trigger V4L2 device creation by writing to sysfs
    hw_log "  Triggering V4L2 device enumeration..."
    
    # Method 1: Trigger camera sensor probe
    if [ -f /sys/devices/platform/soc/soc:cam-subsys/driver/probe ]; then
        echo "soc:cam-subsys" > /sys/devices/platform/soc/soc:cam-subsys/driver/probe 2>/dev/null
        hw_log "    Triggered camera subsystem probe"
    fi
    
    # Method 2: Manually create video devices if they don't exist
    if [ ! -e /dev/video0 ]; then
        hw_log "  Creating V4L2 video device nodes..."
        
        # Create video devices (typically 0-15 for SPRD camera system)
        for i in $(seq 0 15); do
            if [ ! -e /dev/video$i ]; then
                mknod /dev/video$i c 81 $i 2>/dev/null
                hw_log "    Created: /dev/video$i"
            fi
        done
    fi
    
    # Create media devices
    if [ ! -e /dev/media0 ]; then
        hw_log "  Creating media controller devices..."
        for i in $(seq 0 3); do
            if [ ! -e /dev/media$i ]; then
                mknod /dev/media$i c 250 $i 2>/dev/null
                hw_log "    Created: /dev/media$i"
            fi
        done
    fi
    
    # Create v4l-subdev devices
    if [ ! -e /dev/v4l-subdev0 ]; then
        hw_log "  Creating V4L2 subdev nodes..."
        for i in $(seq 0 7); do
            minor=$((128 + i))
            if [ ! -e /dev/v4l-subdev$i ]; then
                mknod /dev/v4l-subdev$i c 81 $minor 2>/dev/null
                hw_log "    Created: /dev/v4l-subdev$i"
            fi
        done
    fi
    
    # Wait for devices to settle
    sleep 2
    
    # Verify V4L2 devices were created
    VIDEO_COUNT=$(ls /dev/video* 2>/dev/null | wc -l)
    MEDIA_COUNT=$(ls /dev/media* 2>/dev/null | wc -l)
    SUBDEV_COUNT=$(ls /dev/v4l-subdev* 2>/dev/null | wc -l)
    
    hw_log "  V4L2 Initialization Summary:"
    hw_log "    Video devices: $VIDEO_COUNT"
    hw_log "    Media devices: $MEDIA_COUNT"
    hw_log "    Subdev devices: $SUBDEV_COUNT"
    
    if [ $VIDEO_COUNT -gt 0 ] || [ $MEDIA_COUNT -gt 0 ]; then
        hw_log "  ✓ V4L2 camera system initialized successfully"
        return 0
    else
        hw_log "  ⚠ V4L2 camera initialization incomplete"
        return 1
    fi
}

# === CAMERA REGULATOR AND GPIO VERIFICATION ===
verify_camera_power() {
    hw_log "=== Verifying Camera Power Supplies and GPIOs ==="
    
    # Check for camera voltage regulators
    hw_log "  Checking camera regulators..."
    
    if [ -d /sys/class/regulator/regulator.302 ] || \
       grep -q "vddcama" /sys/kernel/debug/regulator/regulator_summary 2>/dev/null; then
        hw_log "    ✓ vddcama regulator available (analog power)"
    else
        hw_log "    ⚠ vddcama regulator not found"
    fi
    
    if [ -d /sys/class/regulator/regulator.299 ] || \
       grep -q "vddcamd" /sys/kernel/debug/regulator/regulator_summary 2>/dev/null; then
        hw_log "    ✓ vddcamd regulator available (digital power)"
    else
        hw_log "    ⚠ vddcamd regulator not found"
    fi
    
    if [ -d /sys/class/regulator/regulator.142 ] || \
       grep -q "vddio" /sys/kernel/debug/regulator/regulator_summary 2>/dev/null; then
        hw_log "    ✓ vddio regulator available (I/O power)"
    else
        hw_log "    ⚠ vddio regulator not found"
    fi
    
    # Check sprd_sensor module for GPIO status
    hw_log "  Checking camera GPIO configuration..."
    dmesg | grep -i "sprd_sensor_parse_gpio" | tail -n 5 | while read line; do
        hw_log "    dmesg: $line"
    done
}

# === CAMERA GPIO INITIALIZATION ===
initialize_camera_gpio() {
    hw_log "=== Initializing Camera GPIOs ==="
    
    # Export common camera GPIOs
    CAMERA_GPIOS="119 120 121 122 123 124 125 126"
    
    for gpio in $CAMERA_GPIOS; do
        if [ ! -d /sys/class/gpio/gpio$gpio ]; then
            echo $gpio > /sys/class/gpio/export 2>/dev/null
            if [ $? -eq 0 ]; then
                hw_log "  ✓ Exported GPIO $gpio"
                echo out > /sys/class/gpio/gpio$gpio/direction 2>/dev/null
                echo 0 > /sys/class/gpio/gpio$gpio/value 2>/dev/null
            fi
        fi
    done
    
    hw_log "  Camera GPIO initialization complete"
}

# === DCAM (Digital Camera) INITIALIZATION ===
initialize_dcam() {
    hw_log "=== Initializing DCAM (Digital Camera Controller) ==="
    
    # Check for DCAM device in sysfs
    DCAM_PATHS="/sys/devices/platform/soc/soc:cam-subsys/dcam* \
                /sys/devices/platform/dcam* \
                /sys/module/sprd_sensor/parameters"
    
    for path in $DCAM_PATHS; do
        if [ -e "$path" ]; then
            hw_log "  ✓ Found DCAM path: $path"
        fi
    done
    
    # Enable DCAM if control file exists
    if [ -f /sys/devices/platform/soc/soc:cam-subsys/dcam_enable ]; then
        echo 1 > /sys/devices/platform/soc/soc:cam-subsys/dcam_enable 2>/dev/null
        hw_log "  ✓ Enabled DCAM controller"
    fi
    
    if [ -d /sys/module/sprd_sensor/parameters ]; then
        hw_log "  ✓ DCAM parameters accessible"
    fi
}

# === VIRTUAL FILESYSTEM INITIALIZATION ===
hw_log "=== Creating Virtual Filesystems ==="

mkdir -p /dev/pts 2>/dev/null
mkdir -p /dev/shm 2>/dev/null
mkdir -p /tmp 2>/dev/null
mkdir -p /tmp/runtime 2>/dev/null
mkdir -p /run 2>/dev/null

if ! mount | grep -q "/dev/pts"; then
    mount -t devpts devpts /dev/pts -o mode=0620,gid=5 2>/dev/null
    if [ $? -eq 0 ]; then
        hw_log "  ✓ Mounted /dev/pts (pseudo-terminals)"
    else
        hw_log "  ⚠ Failed to mount /dev/pts"
    fi
else
    hw_log "  ✓ /dev/pts already mounted"
fi

if ! mount | grep -q "/dev/shm"; then
    mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs /dev/shm 2>/dev/null
    if [ $? -eq 0 ]; then
        hw_log "  ✓ Mounted /dev/shm (shared memory)"
    else
        hw_log "  ⚠ Failed to mount /dev/shm"
    fi
else
    hw_log "  ✓ /dev/shm already mounted"
fi

if ! mount | grep -q "tmpfs on /tmp"; then
    mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs /tmp 2>/dev/null
    if [ $? -eq 0 ]; then
        hw_log "  ✓ Mounted /tmp as tmpfs"
        mkdir -p /tmp/runtime 2>/dev/null
        chmod 1777 /tmp/runtime 2>/dev/null
    else
        hw_log "  ⚠ Failed to mount /tmp as tmpfs"
    fi
else
    hw_log "  ✓ /tmp already mounted as tmpfs"
fi

if ! mount | grep -q "/run"; then
    mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run 2>/dev/null
    if [ $? -eq 0 ]; then
        hw_log "  ✓ Mounted /run (runtime data)"
    else
        hw_log "  ⚠ Failed to mount /run"
    fi
else
    hw_log "  ✓ /run already mounted"
fi

# === ANDROID/HALIUM SPECIFIC DIRECTORIES ===
hw_log "=== Creating Android/Halium Directories ==="

# Android property system directory (Halium 9+)
mkdir -p /dev/__properties__ 2>/dev/null
chmod 755 /dev/__properties__ 2>/dev/null
if [ -d /dev/__properties__ ]; then
    hw_log "  ✓ Created /dev/__properties__ (Android property system)"
else
    hw_log "  ⚠ Failed to create /dev/__properties__"
fi

# Android socket communication directory
mkdir -p /dev/socket 2>/dev/null
chmod 755 /dev/socket 2>/dev/null
if [ -d /dev/socket ]; then
    hw_log "  ✓ Created /dev/socket (Android socket directory)"
else
    hw_log "  ⚠ Failed to create /dev/socket"
fi

# Mount /apex as tmpfs if it exists (Halium 9+, Android modular system components)
if [ -e "/apex" ]; then
    if ! mount | grep -q "/apex"; then
        mount -t tmpfs tmpfs /apex 2>/dev/null
        if [ $? -eq 0 ]; then
            hw_log "  ✓ Mounted /apex as tmpfs (Android modular components)"
        else
            hw_log "  ⚠ Failed to mount /apex"
        fi
    else
        hw_log "  ✓ /apex already mounted"
    fi
else
    hw_log "  ℹ /apex does not exist, skipping mount"
fi

hw_log "=== Starting Hardware Device Configuration ==="

# === CORE SYSTEM DEVICES (per ueventd.rc) ===
hw_log "=== Configuring Core System Devices ==="
configure_device_perm "/dev/null" "666" "root" "root"
configure_device_perm "/dev/zero" "666" "root" "root"
configure_device_perm "/dev/full" "666" "root" "root"
configure_device_perm "/dev/ptmx" "666" "root" "root"
configure_device_perm "/dev/tty" "666" "root" "root"
configure_device_perm "/dev/random" "666" "root" "root"
configure_device_perm "/dev/urandom" "666" "root" "root"
configure_device_perm "/dev/hw_random" "440" "root" "system"

# === BINDERFS INITIALIZATION (Android Binder IPC) ===
hw_log "=== Initializing Binderfs (Android Binder IPC) ==="

mkdir -p /dev/binderfs 2>/dev/null

if ! lsmod | grep -q "^binder_linux"; then
    hw_log "  Loading binder_linux module..."
    modprobe binder_linux devices="binder,hwbinder,vndbinder" 2>/dev/null || \
    modprobe binder devices="binder,hwbinder,vndbinder" 2>/dev/null
    sleep 1
fi

if ! mount | grep -q "/dev/binderfs"; then
    mount -t binder binder /dev/binderfs 2>/dev/null
    if [ $? -eq 0 ]; then
        hw_log "  ✓ Mounted binderfs at /dev/binderfs"
    else
        hw_log "  ⚠ Failed to mount binderfs (trying legacy method)"
        if [ -c /dev/binder ]; then
            hw_log "  ✓ Using legacy binder devices"
        fi
    fi
else
    hw_log "  ✓ binderfs already mounted"
fi

# Configure binder devices (0666 per ueventd.rc)
hw_log "  Configuring binder device nodes..."
if [ -d /dev/binderfs ]; then
    configure_device_perm "/dev/binderfs/binder" "666" "root" "root"
    configure_device_perm "/dev/binderfs/hwbinder" "666" "root" "root"
    configure_device_perm "/dev/binderfs/vndbinder" "666" "root" "root"
    
    # Create symlinks from /dev/binderfs/*binder to /dev (Halium compatibility)
    hw_log "  Creating binder symlinks for Halium compatibility..."
    for binder_dev in binder hwbinder vndbinder; do
        if [ -e "/dev/binderfs/$binder_dev" ] && [ ! -e "/dev/$binder_dev" ]; then
            ln -s "/dev/binderfs/$binder_dev" "/dev/$binder_dev" 2>/dev/null
            if [ $? -eq 0 ]; then
                hw_log "    ✓ Created symlink: /dev/$binder_dev -> /dev/binderfs/$binder_dev"
            else
                hw_log "    ⚠ Failed to create symlink for $binder_dev"
            fi
        elif [ -e "/dev/$binder_dev" ]; then
            hw_log "    ✓ /dev/$binder_dev already exists"
        fi
    done
else
    configure_device_perm "/dev/binder" "666" "root" "root"
    configure_device_perm "/dev/hwbinder" "666" "root" "root"
    configure_device_perm "/dev/vndbinder" "666" "root" "root"
fi

hw_log "  Binderfs initialization complete"

# === ASHMEM (0666) ===
configure_device_group_perm "/dev/ashmem*" "666" "root" "root" "Ashmem Devices"

# === PMSG (0222 write-only for logging) ===
configure_device_perm "/dev/pmsg0" "222" "root" "log"

# === UNISOC LTE DEVICES ===
hw_log "=== Configuring UNISOC LTE Devices ==="
# Most LTE pipes are 0660 system:system
configure_device_group_perm "/dev/spipe_lte*" "660" "system" "system" "UNISOC LTE Pipe Devices (default)"

# Override specific LTE pipes with different permissions
configure_device_perm "/dev/spipe_lte4" "660" "media" "audio"
configure_device_perm "/dev/spipe_lte5" "660" "radio" "system"
configure_device_perm "/dev/spipe_lte6" "660" "media" "audio"
configure_device_perm "/dev/spipe_lte9" "660" "radio" "radio"
configure_device_perm "/dev/spipe_lte14" "660" "audioserver" "audio"

# LTE TTY Devices (0660 radio:system)
configure_device_group_perm "/dev/stty_lte*" "660" "radio" "system" "UNISOC LTE TTY Devices"

# === UNISOC LOG DEVICES (0660 system:system) ===
hw_log "=== Configuring UNISOC Log Devices ==="
configure_device_perm "/dev/slog_lte" "660" "system" "system"
configure_device_perm "/dev/slog_pm" "660" "system" "system"
configure_device_perm "/dev/slog_gnss" "660" "system" "system"
configure_device_perm "/dev/slog_wcn0" "660" "system" "system"
configure_device_group_perm "/dev/slog_*" "660" "system" "system" "Additional UNISOC Log Devices"

# === UNISOC DIAGNOSTIC DEVICES (0660 system:system) ===
configure_device_perm "/dev/sdiag_lte" "660" "system" "system"

# === UNISOC POWER MANAGEMENT DEVICES ===
hw_log "=== Configuring UNISOC Power Management Devices ==="
configure_device_perm "/dev/sctl_pm" "660" "system" "system"
configure_device_perm "/dev/power_ctl" "660" "system" "system"
# spipe_pm devices are 0666 per ueventd.rc
configure_device_group_perm "/dev/spipe_pm*" "666" "system" "system" "UNISOC Power Management Pipes"

# === TTY GADGET SERIAL DEVICES (0660 system:system) ===
hw_log "=== Configuring TTY Gadget Serial Devices ==="
tty_count=0
for i in $(seq 0 7); do
    if configure_device_perm "/dev/ttyGS$i" "660" "system" "system"; then
        tty_count=$((tty_count + 1))
    fi
done
hw_log "  Total TTY gadget devices configured: $tty_count"

# === STANDARD SERIAL DEVICES (0660 system:system) ===
hw_log "=== Configuring Standard Serial Devices ==="
configure_device_perm "/dev/ttyS0" "660" "system" "system"
configure_device_perm "/dev/ttyS1" "660" "system" "system"
configure_device_perm "/dev/ttyS3" "660" "system" "system"
configure_device_perm "/dev/ttyS4" "660" "system" "system"

# === ADDITIONAL SERIAL DEVICES ===
configure_device_perm "/dev/vser" "660" "system" "system"
configure_device_perm "/dev/tty0" "660" "root" "system"

# === GPIO CONTROLLER DEVICES ===
hw_log "=== Configuring GPIO Controller Devices ==="
gpio_count=0
for i in $(seq 0 5); do
    # Not in ueventd.rc, using default 660 root:system
    if configure_device_perm "/dev/gpiochip$i" "660" "root" "system"; then
        gpio_count=$((gpio_count + 1))
    fi
done
hw_log "  Total GPIO devices configured: $gpio_count"

# === I2C BUS AND CAMERA SENSOR INITIALIZATION ===
hw_log "=== Configuring I2C Bus Devices with Camera Sensors ==="

# I2C devices shown to specifications in adb shell
hw_log "Configuring I2C-0 (0x70300000) - Main Camera Bus..."
if configure_device_perm "/dev/i2c-0" "660" "root" "system"; then
    hw_log "  ✓ I2C-0 configured"
    
    if [ -d /sys/bus/i2c/devices/0-0020 ]; then
        hw_log "    ✓ Detected sensor-main@20 (I2C address 0x20)"
        if [ -f /sys/bus/i2c/devices/0-0020/name ]; then
            SENSOR_NAME=$(cat /sys/bus/i2c/devices/0-0020/name 2>/dev/null)
            hw_log "      Sensor name: $SENSOR_NAME"
        fi
    else
        hw_log "    ⚠ sensor-main@20 not detected on I2C-0"
    fi
    
    if [ -d /sys/bus/i2c/devices/0-0021 ]; then
        hw_log "    ✓ Detected deputy-camera@21 (I2C address 0x21)"
    else
        hw_log "    ⚠ deputy-camera@21 not detected on I2C-0"
    fi
fi

hw_log "Configuring I2C-1 (0x70400000) - Secondary Camera Bus..."
if configure_device_perm "/dev/i2c-1" "660" "root" "system"; then
    hw_log "  ✓ I2C-1 configured"
    
    if [ -d /sys/bus/i2c/devices/1-002a ]; then
        hw_log "    ✓ Detected sensor-main2@2a (I2C address 0x2A)"
    else
        hw_log "    ⚠ sensor-main2@2a not detected on I2C-1"
    fi
    
    if [ -d /sys/bus/i2c/devices/1-006c ]; then
        hw_log "    ✓ Detected sensor-sub@6c (I2C address 0x6C)"
    else
        hw_log "    ⚠ sensor-sub@6c not detected on I2C-1"
    fi
fi

hw_log "Configuring I2C-2 (0x70500000) - Reserved Bus..."
configure_device_perm "/dev/i2c-2" "660" "root" "system"

hw_log "Configuring I2C-3 (0x70600000) - Unknown Device Bus..."
if configure_device_perm "/dev/i2c-3" "660" "root" "system"; then
    if [ -d /sys/bus/i2c/devices/3-005a ]; then
        hw_log "    ✓ Detected device at 3-005a (I2C address 0x5A)"
    fi
fi

hw_log "Configuring I2C-4 (0x70700000) - Unknown Device Bus..."
if configure_device_perm "/dev/i2c-4" "660" "root" "system"; then
    if [ -d /sys/bus/i2c/devices/4-006a ]; then
        hw_log "    ✓ Detected device at 4-006a (I2C address 0x6A)"
    fi
fi

hw_log "Configuring I2C-5 (0x32060000) - AON Power Management Bus..."
if configure_device_perm "/dev/i2c-5" "660" "root" "system"; then
    hw_log "  ✓ I2C-5 (AON bus) configured"
    
    if [ -d /sys/bus/i2c/devices/5-0060 ]; then
        hw_log "    ✓ Detected power management device at 5-0060"
    fi
    
    if [ -d /sys/bus/i2c/devices/5-0062 ]; then
        hw_log "    ✓ Detected power management device at 5-0062"
    fi
fi

hw_log "  Total I2C buses configured: 6"

# === IIO SENSOR DEVICES (0660 system:system) ===
