# Reference: <https://moorechip.org/devicepkg>
pkgname=device-moorechip-rp3plus
pkgdesc="Retroid Pocket 3 Plus (Tiger T618 UMS512)"
pkgver=1
pkgrel=5
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-moorechip-rp3plus
	make-dynpart-mappings
	mkbootimg
	e2fsprogs-extra
	dosfstools
	android-tools
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	load-firmware.sh
	90-firmware-loader.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	
	# Install firmware loading rules
	install -Dm644 "$srcdir"/90-firmware-loader.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	
	# Install firmware loading script
	install -Dm755 "$srcdir"/load-firmware.sh \
		"$pkgdir"/usr/libexec/moorechip-rp3plus-firmware.sh
}


