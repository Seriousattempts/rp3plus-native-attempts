#!/system/bin/sh

# ---- Unified logging setup ----
BOOT_LOG="/boot/init_debug_full.log"
FALLBACK_LOG="/init_debug_full.log"

# Ensure /boot is writable
mountpoint -q /boot && mount -o remount,rw /boot 2>/dev/null

# Pick single log file for everything
if touch "$BOOT_LOG".wtest 2>/dev/null; then
  LOGFILE="$BOOT_LOG"
  rm -f "$BOOT_LOG".wtest
else
  LOGFILE="$FALLBACK_LOG"
fi

# Clear existing log
> "$LOGFILE"

# Unified logging function
log() {
  TS="$(/system/bin/uptime 2>/dev/null | cut -d' ' -f1 2>/dev/null)"
  [ -z "$TS" ] && TS="T"
  echo "[$TS] $*" | tee -a "$LOGFILE" >/dev/null
}

log "=== Starting Linux rootfs initialization ==="
log "LOG FILE: $LOGFILE"
log "BOOTLOADER LCD INFO: lcd_name=lcd_FC11339_mipi_hd lcd_base=9e000000 lcd_size=1336x752"

# ---- Mount rootfs image ----
ROOTFS_IMG="/boot/boot/rootfs.f2fs"
log "MOUNT: Mounting F2FS rootfs from $ROOTFS_IMG"
if mount -t f2fs -o loop "$ROOTFS_IMG" /root 2>>"$LOGFILE"; then
  log "MOUNT: Rootfs mounted successfully"
else
  log "ERROR: Failed to mount rootfs image: $ROOTFS_IMG"
  exit 1
fi

# ---- Bind boot partition ----
log "MOUNT: Bind mounting boot partition to /root/media"
mkdir -p /root/media
log "CREATED: /root/media directory"
if mount -o bind /boot /root/media 2>>"$LOGFILE"; then
  log "MOUNT: Bound /boot -> /root/media"
else
  log "WARNING: Failed to bind /boot -> /root/media"
fi

# ---- Graphics device setup ----
log "=== GRAPHICS SETUP START ==="
mkdir -p /root/dev/dri /root/dev/graphics
log "CREATED: /root/dev/dri and /root/dev/graphics directories"

# Bind mount DRI devices
if [ -d /dev/dri ]; then
  mount -o bind /dev/dri /root/dev/dri 2>>"$LOGFILE"
  log "MOUNT: Bound /dev/dri -> /root/dev/dri"
  ls -la /dev/dri 2>>"$LOGFILE" | while read line; do log "DRI DEVICE: $line"; done
else
  log "WARNING: /dev/dri not found on host"
fi

# Check for additional graphics devices
for gfx_dev in /dev/mali* /dev/fb* /dev/graphics/*; do
  if [ -e "$gfx_dev" ]; then
    mkdir -p "/root$(dirname $gfx_dev)"
    mount -o bind "$gfx_dev" "/root$gfx_dev" 2>>"$LOGFILE"
    log "MOUNT: Bound $gfx_dev -> /root$gfx_dev"
    log "GFX DEVICE: $(ls -la $gfx_dev)"
  fi
done
log "=== GRAPHICS SETUP END ==="

# ---- Config.xml handling (FIXED) ----
log "=== CONFIG.XML SEARCH START ==="
log "Searching for config.xml on SD card..."

# Check if config.xml exists at /boot/config.xml directly
if [ -f /boot/config.xml ]; then
  log "FOUND: config.xml at /boot/config.xml"
  mkdir -p /root/media/boot
  log "CREATED: /root/media/boot directory"
  cp -f /boot/config.xml /root/media/boot/config.xml 2>>"$LOGFILE"
  log "COPY: /boot/config.xml -> /root/media/boot/config.xml"
  log "CONFIG: Verified config.xml size: $(wc -c < /boot/config.xml) bytes"
else
  log "WARNING: config.xml not found at /boot/config.xml"
  log "Available files in /boot:"
  ls -la /boot | head -20 | while read line; do log "BOOT: $line"; done
fi
log "=== CONFIG.XML SEARCH END ==="

# ---- Essential filesystem bind mounts ----
log "=== FILESYSTEM BIND MOUNTS START ==="
for f in dev dev/pts proc sys tmp device-resources $DEVICE_CUSTOM_ROOTFS_MOUNTS; do
  log "PROCESSING: directory $f"
  mkdir -p "/root/$f"
  log "CREATED: /root/$f directory"
  
  if mount -o bind "/$f" "/root/$f" 2>>"$LOGFILE"; then
    log "MOUNT: Successfully bound /$f -> /root/$f"
  else
    log "WARNING: Failed to bind /$f -> /root/$f"
  fi
done
log "=== FILESYSTEM BIND MOUNTS END ==="

# ---- Firmware and modules setup ----
log "=== FIRMWARE SETUP START ==="
mkdir -p /root/lib/firmware /root/vendor/firmware /root/firmware /root/lib/modules
log "CREATED: firmware and modules directories"

mount -o bind /lib/firmware /root/lib/firmware 2>>"$LOGFILE"
mount -o bind /vendor/firmware /root/vendor/firmware 2>>"$LOGFILE"
mount -o bind /firmware /root/firmware 2>>"$LOGFILE"
mount -o bind /lib/modules /root/lib/modules 2>>"$LOGFILE"
log "MOUNT: Bound all firmware and modules directories"
log "=== FIRMWARE SETUP END ==="

# ---- binderfs setup ----
log "=== BINDERFS SETUP START ==="
mkdir -p /root/dev/binderfs
log "CREATED: /root/dev/binderfs directory"

if [ -d /dev/binderfs ]; then
  mount -o bind /dev/binderfs /root/dev/binderfs 2>>"$LOGFILE"
  log "MOUNT: Bound /dev/binderfs -> /root/dev/binderfs"
  
  chroot /root /bin/sh -c "
    ln -sf /dev/binderfs/binder /dev/binder 2>/dev/null
    ln -sf /dev/binderfs/hwbinder /dev/hwbinder 2>/dev/null
    ln -sf /dev/binderfs/vndbinder /dev/vndbinder 2>/dev/null
  " 2>>"$LOGFILE"
  log "SYMLINK: Created binderfs device symlinks in chroot"
else
  log "WARNING: binderfs not found on host system"
fi
log "=== BINDERFS SETUP END ==="

# ---- Environment setup with DEVICE_CODENAME ----
log "=== ENVIRONMENT SETUP START ==="
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export HOME=/root
export SHELL=/bin/sh

# Set DEVICE_CODENAME to make audio/display providers work
# Choose one based on what you want to test:
export DEVICE_CODENAME="rg35xx+"
# export DEVICE_CODENAME="pocket2plus" DOES NOT WORK
# No clue how it apparently worked but no one provided video evidence
# https://github.com/GarlicOS/buildroot/compare/v2.0.1...v2.0.2
# https://github.com/GarlicOS/buildroot/compare/v2.0.0...v2.0.2
# https://github.com/search?q=repo%3AGarlicOS%2Fbuildroot%20DEVICE_CODENAME&type=code
# worked for the pocket 3 using the 2plus apparently https://www.reddit.com/r/SBCGaming/comments/17ykvrh/i_tested_garlicos_on_the_retroid_pocket_3/

log "ENVIRONMENT: Set PATH, HOME, SHELL"
log "ENVIRONMENT: Set DEVICE_CODENAME=$DEVICE_CODENAME"

# Set CPU governors
count=0
for policy_dir in /sys/devices/system/cpu/cpufreq/policy*; do
  if [ -d "$policy_dir" ]; then
    echo performance > "$policy_dir/scaling_governor" 2>>"$LOGFILE" && count=$((count+1))
    log "CPU: Set $(basename "$policy_dir") governor to performance"
  fi
done
log "CPU: Set $count governors to performance mode"
log "=== ENVIRONMENT SETUP END ==="

# ---- ROOTFS CONTENT AUDIT ----
log "=== ROOTFS CONTENT AUDIT START ==="

# Check for key executables
for exec_path in /usr/bin/display /bin/display /sbin/display /usr/bin/audio /bin/audio /sbin/audio /usr/bin/gamepad /bin/gamepad /usr/bin/garlicui /bin/garlicui; do
  if [ -f "/root$exec_path" ]; then
    log "FOUND EXECUTABLE: $exec_path"
    file_output=$(file "/root$exec_path" 2>/dev/null)
    log "FILE TYPE: $file_output"
    
    if echo "$file_output" | grep -q "script"; then
      log "SCRIPT CONTENT (first 10 lines):"
      head -n 10 "/root$exec_path" | while read line; do
        log "SCRIPT: $line"
      done
    else
      log "BINARY STRINGS (graphics/audio related):"
      strings "/root$exec_path" 2>/dev/null | grep -iE 'drm|kms|egl|gbm|fb|alsa|pulse|audio|sound' | head -10 | while read line; do
        log "STRINGS: $line"
      done
    fi
  else
    log "MISSING: $exec_path"
  fi
done

# Check audio devices in chroot
log "AUDIO DEVICES IN CHROOT:"
ls -la /root/dev/snd/ 2>>"$LOGFILE" | while read line; do log "AUDIO: $line"; done

log "=== ROOTFS CONTENT AUDIT END ==="

# ---- Pre-chroot verification ----
log "=== PRE-CHROOT VERIFICATION START ==="
if [ -r /proc/meminfo ]; then
  avail=$(grep -m1 MemAvailable /proc/meminfo | cut -d: -f2 | tr -d ' ')
  log "MEMORY: Available $avail"
fi

if [ ! -x /root/usr/bin/init ]; then
  log "ERROR: /usr/bin/init missing or not executable"
  exit 1
fi
log "INIT: /usr/bin/init verified executable"

# Verify config.xml accessibility
if [ -f /root/media/boot/config.xml ]; then
  log "CONFIG: Verified config.xml accessible at /media/boot/config.xml in chroot"
  log "CONFIG SIZE: $(wc -c < /root/media/boot/config.xml) bytes"
else
  log "ERROR: config.xml still not accessible in chroot"
fi

log "=== PRE-CHROOT VERIFICATION END ==="

# ---- Final handoff with environment ----
sync
log "=== CHROOT HANDOFF ==="
log "Environment variables being passed to chroot:"
log "DEVICE_CODENAME=$DEVICE_CODENAME"
log "PATH=$PATH"
log "Executing chroot to /root with /usr/bin/init"
log "=== END OF INIT SCRIPT (pre-chroot) ==="

# Pass environment variables to chroot
exec >>"$LOGFILE" 2>&1
chroot /root /usr/bin/env DEVICE_CODENAME="$DEVICE_CODENAME" PATH="$PATH" HOME="$HOME" SHELL="$SHELL" /usr/bin/init

# Should never reach here
RC=$?
log "ERROR: chroot returned unexpectedly with exit code $RC"
exit $RC
