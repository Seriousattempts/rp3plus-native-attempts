import xml.etree.ElementTree as ET


def compare_bma_config_files(file1_path, file2_path):
    """
    Compare two BMAConfig XML files and print differences.

    Args:
        file1_path (str): Path to the first XML file
        file2_path (str): Path to the second XML file
    """
    # Parse both XML files
    tree1 = ET.parse(file1_path)
    root1 = tree1.getroot()
    tree2 = ET.parse(file2_path)
    root2 = tree2.getroot()

    def extract_productlist(root):
        products = {}
        productlist_elem = root.find('ProductList')
        if productlist_elem is not None:
            for product in productlist_elem.findall('Product'):
                product_name = product.get('name')
                product_info = {}
                # Extract simple direct children
                for tag in ['SchemeName', 'FlashTypeID', 'Mode', 'PowerOff', 'APR']:
                    elem = product.find(tag)
                    product_info[tag] = elem.text if elem is not None else None
                # Extract NVBackup and its NVItems
                nvbackup_elem = product.find('NVBackup')
                if nvbackup_elem is not None:
                    product_info['NVBackup'] = nvbackup_elem.get('backup')
                    nvitems = {}
                    for nvitem in nvbackup_elem.findall('NVItem'):
                        nvname = nvitem.get('name')
                        nvinfo = {'backup': nvitem.get('backup')}
                        id_elem = nvitem.find('ID')
                        nvinfo['ID'] = id_elem.text if id_elem is not None else None
                        backupflag_elem = nvitem.find('BackupFlag')
                        if backupflag_elem is not None:
                            nvinfo['BackupFlag_use'] = backupflag_elem.get('use')
                            nvflags = {}
                            for nvflag in backupflag_elem.findall('NVFlag'):
                                name = nvflag.get('name')
                                check = nvflag.get('check')
                                nvflags[name] = check
                            nvinfo['NVFlags'] = nvflags
                        nvitems[nvname] = nvinfo
                    product_info['NVItems'] = nvitems
                products[product_name] = product_info
        return products

    def extract_partitions(root):
        partitions = {}
        partitions_elem = root.find('Partitions')
        if partitions_elem is not None:
            for part in partitions_elem.findall('Partition'):
                part_id = part.get('id')
                size = part.get('size')
                partitions[part_id] = size
        return partitions

    def extract_schemelist(root):
        schemelist = {}
        schemelist_elem = root.find('SchemeList')
        if schemelist_elem is not None:
            for scheme in schemelist_elem.findall('Scheme'):
                scheme_name = scheme.get('name')
                files = []
                for file_elem in scheme.findall('File'):
                    fid = file_elem.find('ID').text if file_elem.find('ID') is not None else None
                    fidalias = file_elem.find('IDAlias').text if file_elem.find('IDAlias') is not None else None
                    ftype = file_elem.find('Type').text if file_elem.find('Type') is not None else None
                    block = file_elem.find('Block')
                    base = block.find('Base').text if block is not None and block.find('Base') is not None else None
                    size = block.find('Size').text if block is not None and block.find('Size') is not None else None
                    flag = file_elem.find('Flag').text if file_elem.find('Flag') is not None else None
                    checkflag = file_elem.find('CheckFlag').text if file_elem.find('CheckFlag') is not None else None
                    desc = file_elem.find('Description').text if file_elem.find('Description') is not None else None
                    files.append({
                        'ID': fid,
                        'IDAlias': fidalias,
                        'Type': ftype,
                        'Base': base,
                        'Size': size,
                        'Flag': flag,
                        'CheckFlag': checkflag,
                        'Description': desc
                    })
                schemelist[scheme_name] = files
        return schemelist

    products1 = extract_productlist(root1)
    products2 = extract_productlist(root2)

    partitions1 = extract_partitions(root1)
    partitions2 = extract_partitions(root2)

    schemes1 = extract_schemelist(root1)
    schemes2 = extract_schemelist(root2)

    # Comparison helper function
    def dict_diff(d1, d2, prefix):
        diffs = []
        keys = set(d1.keys()).union(set(d2.keys()))
        for k in keys:
            v1 = d1.get(k)
            v2 = d2.get(k)
            if v1 != v2:
                diffs.append(f"{prefix} '{k}': '{v1}' vs '{v2}'")
        return diffs

    differences = []

    # Compare ProductList
    all_product_names = set(products1.keys()).union(products2.keys())
    for pname in all_product_names:
        p1 = products1.get(pname, {})
        p2 = products2.get(pname, {})
        if not p1:
            differences.append(f"Product '{pname}' missing in first file")
        if not p2:
            differences.append(f"Product '{pname}' missing in second file")
        if p1 and p2:
            # Compare simple attributes
            differences.extend(dict_diff({
                'SchemeName': p1.get('SchemeName'),
                'FlashTypeID': p1.get('FlashTypeID'),
                'Mode': p1.get('Mode'),
                'PowerOff': p1.get('PowerOff'),
                'APR': p1.get('APR'),
                'NVBackup_backup': p1.get('NVBackup')
            }, {
                'SchemeName': p2.get('SchemeName'),
                'FlashTypeID': p2.get('FlashTypeID'),
                'Mode': p2.get('Mode'),
                'PowerOff': p2.get('PowerOff'),
                'APR': p2.get('APR'),
                'NVBackup_backup': p2.get('NVBackup')
            }, f"Product '{pname}'"))

            # Compare NVItems
            nvitems1 = p1.get('NVItems', {})
            nvitems2 = p2.get('NVItems', {})
            all_nvnames = set(nvitems1.keys()).union(nvitems2.keys())
            for nvname in all_nvnames:
                nv1 = nvitems1.get(nvname, {})
                nv2 = nvitems2.get(nvname, {})
                if not nv1:
                    differences.append(f"NVItem '{nvname}' in Product '{pname}' missing in first file")
                if not nv2:
                    differences.append(f"NVItem '{nvname}' in Product '{pname}' missing in second file")
                if nv1 and nv2:
                    differences.extend(dict_diff({
                        'backup': nv1.get('backup'),
                        'ID': nv1.get('ID'),
                        'BackupFlag_use': nv1.get('BackupFlag_use')
                    }, {
                        'backup': nv2.get('backup'),
                        'ID': nv2.get('ID'),
                        'BackupFlag_use': nv2.get('BackupFlag_use')
                    }, f"NVItem '{nvname}' in Product '{pname}'"))
                    # Compare NVFlags
                    nvflags1 = nv1.get('NVFlags', {})
                    nvflags2 = nv2.get('NVFlags', {})
                    all_nvflags = set(nvflags1.keys()).union(nvflags2.keys())
                    for nf in all_nvflags:
                        f1 = nvflags1.get(nf)
                        f2 = nvflags2.get(nf)
                        if f1 != f2:
                            differences.append(
                                f"NVFlag '{nf}' in NVItem '{nvname}' Product '{pname}': check='{f1}' vs check='{f2}'")

    # Compare Partitions
    all_parts = set(partitions1.keys()).union(partitions2.keys())
    for pid in all_parts:
        s1 = partitions1.get(pid)
        s2 = partitions2.get(pid)
        if s1 != s2:
            differences.append(f"Partition id '{pid}': size '{s1}' vs '{s2}'")

    # Compare SchemeList - NEW IMPROVED LOGIC
    all_scheme_names = set(schemes1.keys()).union(schemes2.keys())
    for sname in all_scheme_names:
        files1 = schemes1.get(sname, [])
        files2 = schemes2.get(sname, [])

        # Create mapping from ID to file for better comparison
        files_map1 = {f['ID']: f for f in files1 if f['ID']}
        files_map2 = {f['ID']: f for f in files2 if f['ID']}
        all_ids = set(files_map1.keys()).union(files_map2.keys())

        # Check for missing IDs and differences
        for fid in all_ids:
            f1 = files_map1.get(fid)
            f2 = files_map2.get(fid)

            if f1 is None:
                differences.append(f"SchemeList '{sname}' has ID '{fid}' only in second BMAConfig file")
            elif f2 is None:
                differences.append(f"SchemeList '{sname}' has ID '{fid}' only in first BMAConfig file")
            else:
                # Compare all attributes for files with the same ID
                for key in ['IDAlias', 'Type', 'Base', 'Size', 'Flag', 'CheckFlag', 'Description']:
                    v1 = f1.get(key)
                    v2 = f2.get(key)
                    if v1 != v2:
                        differences.append(
                            f"SchemeList '{sname}': ID = {fid} | {key} = {v1} [First BMAConfig] | {key} = {v2} [Second BMAConfig]")

    # Print the differences
    print("=" * 60)
    print("BMAConfig XML File Comparison Results")
    print("=" * 60)
    if differences:
        print(f"Found {len(differences)} differences:")
        print()
        for i, diff in enumerate(differences, 1):
            print(f"{i:3}. {diff}")
    else:
        print("No differences found between the two BMAConfig XML files.")
    print("=" * 60)


def main():
    """Main function to get file paths from user input and run comparison."""
    print("BMAConfig XML File Comparator")
    print("=" * 40)

    file1_path = input("Enter path for first BMAConfig XML file: ").strip()
    file2_path = input("Enter path for second BMAConfig XML file: ").strip()

    try:
        compare_bma_config_files(file1_path, file2_path)
    except FileNotFoundError as e:
        print(f"Error: Could not find file - {e}")
    except ET.ParseError as e:
        print(f"Error: Could not parse XML file - {e}")
    except Exception as e:
        print(f"Error: {e}")


if __name__ == "__main__":
    main()
